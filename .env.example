# Copy to .env for `netlify dev`. In production these are set in the
# Netlify UI under Site configuration → Environment variables.
FORM_SECRET=generate-with-node-crypto-randomBytes-32-hex
SMTP_USER=your-account@gmail.com
SMTP_PASS=your16charapppassword
MAIL_TO=where-enquiries-land@gmail.com
# Optional extra recipients on the enquiry (comma-separated).
# CC is visible to all recipients, BCC is not. Neither is copied on the
# customer auto-reply.
MAIL_CC=
MAIL_BCC=
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
MAIL_FROM_NAME=Stitch Avenue Website
